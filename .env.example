# Copy this file to .env.deploy. This is the only deployment settings file to edit.
# Shell/CI environment variables take precedence. Never use VITE_ for secrets.

# Required for publishing. Ask the Cloudflare owner; share the token securely.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Must match the existing Worker created by the owner.
CLOUDFLARE_WORKER_NAME=swipe-rush

# Keep true for a public workers.dev URL.
# Set false only after the owner has connected the production Custom Domain.
CLOUDFLARE_WORKERS_DEV=true

# Enable per-version preview URLs only if wanted. Use true or false.
CLOUDFLARE_PREVIEW_URLS=false

# Custom Domains are attached by the owner in Cloudflare, not by this script.
# Use a dedicated hostname (e.g. swipe.example.com), not a subdirectory.
